python run_all_tests.py

# Все тесты game:
python manage.py test game.test

# Все тесты users:
python manage.py test users.test

# Конкретные тестовые файлы:
python manage.py test game.test.test_models
python manage.py test game.test.test_views
python manage.py test game.test.test_security
python manage.py test users.test.test_forms

⚠️ Решение частых проблем
Проблема: Порт уже используется
bash
# Для Docker измените порты в docker-compose.yml
# Для ручного запуска:
python manage.py runserver 8080

Проблема: Ошибка с psycopg2 (PostgreSQL)
bash
# Установите в виртуальное окружение:
pip install psycopg2-binary

# Или используйте SQLite, изменив settings.py:
# DATABASES = {
#     'default': {
#         'ENGINE': 'django.db.backends.sqlite3',
#         'NAME': BASE_DIR / 'db.sqlite3',
#     }
# }

Проблема: Ошибки при запуске тестов
bash
# Убедитесь, что в backend/settings.py закомментированы строки:
# from dotenv import load_dotenv
# load_dotenv()

# Или установите python-dotenv:
pip install python-dotenv